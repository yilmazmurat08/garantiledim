<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 ve üstü. Google bulut yedeğinin uygulama başına 25 MB sınırı var; sınır aşılırsa
    yedek hiç alınmaz. Bu yüzden ürün listesi ve ayarlar yedeklenir, büyük dosyalar (fiş/fatura,
    fotoğraflar ve önizlemeleri) bulut yedeğine konmaz. Telefondan telefona aktarımda sınır yoktur,
    her şey taşınır.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="receipts/" />
        <exclude domain="file" path="photos/" />
        <exclude domain="file" path="thumbs/" />
        <exclude domain="file" path="datastore/premium.preferences_pb" />
    </cloud-backup>
    <!-- Premium satın alma kaydı başka cihaza taşınmaz; yeni telefonda Google Play'den yeniden doğrulanır. -->
    <device-transfer>
        <exclude domain="file" path="datastore/premium.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
